# Normalise line endings so the repository holds LF and Windows checkouts get CRLF.
* text=auto eol=lf

*.cs text eol=lf diff=csharp
*.csproj text eol=lf
*.slnx text eol=lf
*.props text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.bicep text eol=lf
*.bicepparam text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.svg text eol=lf

*.png binary
*.jpg binary
*.ico binary
